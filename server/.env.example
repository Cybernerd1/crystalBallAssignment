# Copy this file to `.env` and adjust the values for your machine.

# Port the Express server listens on
PORT=5000

# MongoDB connection string (required). For a local MongoDB instance:
MONGODB_URI=mongodb://127.0.0.1:27017/forma
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/forma?retryWrites=true&w=majority

# Comma-separated list of origins allowed by CORS (the frontend URL).
# Examples:
#   http://localhost:5173
#   http://localhost:5173,https://forma.example.com
CLIENT_ORIGIN=http://localhost:5173

# development | production | test
NODE_ENV=development
